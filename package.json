{
	"name": "cue",
	"productName": "Cue",
	"desktopName": "cue.desktop",
	"version": "0.2.8",
	"private": true,
	"description": "A fast, lightweight video editor that you and an AI agent edit together.",
	"author": {
		"name": "David Henry Francis Wicker",
		"url": "https://wicker.life"
	},
	"type": "module",
	"main": "dist-electron/main.cjs",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build && npm run build:mcp",
		"build:native": "node scripts/build-native.mjs",
		"build:mcp": "node scripts/build-mcp.mjs",
		"start": "electron .",
		"package": "npm run build && npm run build:native && electron-builder --mac --dir -c.mac.identity=null --publish never",
		"release:mac": "sh scripts/release-mac.sh",
		"dist:win": "npm run build && electron-builder --win --publish never",
		"dist:linux": "npm run build && electron-builder --linux --publish never",
		"test": "vitest --run",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"install:app": "sh scripts/install-app.sh"
	},
	"dependencies": {
		"electron-updater": "^6.8.9",
		"ffmpeg-static": "^5.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@heroui/react": "^3.2.6",
		"@heroui/styles": "^3.2.6",
		"@lottiefiles/dotlottie-web": "^0.80.0",
		"@modelcontextprotocol/sdk": "^1.30.1",
		"@phosphor-icons/react": "^2.1.10",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"clsx": "^2.1.1",
		"electron": "^44.4.5",
		"electron-builder": "^26.15.3",
		"esbuild": "^0.28.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"vite-plugin-electron": "^1.1.2",
		"vitest": "^5.0.2",
		"zod": "^4.6.5"
	},
	"license": "MIT",
	"homepage": "https://cue.wicker.life",
	"repository": {
		"type": "git",
		"url": "https://github.com/davidwickerhf/cue.git"
	}
}
