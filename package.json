{
  "name": "cue",
  "productName": "Cue",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-centred video editor. Record voiceover over a script, review takes, and export — driven by you or by an agent over MCP.",
  "author": "David Wicker",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:mcp",
    "build:mcp": "node scripts/build-mcp.mjs",
    "start": "electron .",
    "package": "npm run build && electron-builder --mac --dir",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.2"
  }
}
